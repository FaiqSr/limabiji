<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Arahkan semua request ke folder /public secara internal
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# 2. Blokir akses langsung ke file tersembunyi seperti .env
<Files .*>
    # Apache 2.2
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
    # Apache 2.4
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</Files>